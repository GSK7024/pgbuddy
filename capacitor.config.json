{
  "appId": "com.pgbuddy.app",
  "appName": "PG Buddy",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#7c3aed",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#7c3aed"
    }
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#ffffff"
  }
}
